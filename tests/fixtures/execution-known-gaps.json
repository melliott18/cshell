{
  "version": 1,
  "name": "CSH-055 prefix PATH regression (also in the default suite)",
  "kind": "replacement",
  "cases": [
    {
      "name": "EXEC-004 prefix PATH selects external pwd",
      "args": ["-c", "chmod +x bin/pwd; PATH=bin pwd\n"],
      "stdin": "",
      "setup": {"bin/pwd": "#!/bin/sh\nprintf 'custom-pwd\\n'\n"},
      "expect": {"stdout": "custom-pwd\n", "stderr": "", "status": 0}
    }
  ]
}
