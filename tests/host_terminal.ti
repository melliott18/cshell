# CSH-077 authored fixture. No inheritance from the host terminal database.
# Five repetitive stops at a width of 40; literal capabilities have no padding.
csh077|CSH-077 disposable terminal,
    cols#41, lines#24,
    clear=CLEAR, is2=INIT, rs2=RESET,
    tbc=CLEAR_TABS, hts=SET_TAB, cr=^M,

csh077plain|CSH-077 terminal without hardware tabs,
    cols#41, lines#24, clear=CLEAR, is2=INIT, rs2=RESET,

csh077empty|CSH-077 known terminal with no operations,
    cols#41, lines#24,

csh077partial|CSH-077 terminal without clear,
    cols#41, lines#24, is2=INIT, rs2=RESET,

csh081narrow|CSH-081 narrow terminal,
    cols#17, lines#24, tbc=CLEAR_TABS, hts=SET_TAB, cr=^M,

# Independently supplied default, so unset/null TERM tests avoid host fallback.
dumb|CSH-081 default with no terminal operations,
    cols#80, lines#24,

csh081phases|CSH-081 three ordered initialization and reset phases,
    cols#41, lines#24, clear=CLEAR,
    is1=INIT1, is2=INIT2, is3=INIT3,
    rs1=RESET1, rs2=RESET2, rs3=RESET3,

csh081fallback|CSH-081 per-phase reset fallback,
    cols#41, lines#24,
    is1=INIT1, is2=INIT2, is3=INIT3, rs2=RESET2,

csh081bytes|CSH-081 literal control and eight-bit bytes,
    cols#41, lines#24, clear=\E[H\E[2J,
    is1=\001\177\200, is3=END,
