+/* POSIX string positions count characters in LC_CTYPE, not bytes. */
+static wchar_t *
+cshell_wide (const char *text)
+{
+  size_t length = mbstowcs (NULL, text, 0);
+  wchar_t *result;
+  if (length == (size_t) -1)
+    M4ERROR ((EXIT_FAILURE, 0, _("invalid multibyte string")));
+  result = xnmalloc (length + 1, sizeof *result);
+  mbstowcs (result, text, length + 1);
+  return result;
+}
+
+static void
+cshell_wide_output (struct obstack *obs, const wchar_t *text, size_t length)
+{
+  mbstate_t state;
+  char bytes[MB_LEN_MAX];
+  size_t i, count;
+  memset (&state, 0, sizeof state);
+  for (i = 0; i < length; ++i)
+    {
+      count = wcrtomb (bytes, text[i], &state);
+      if (count == (size_t) -1)
+        M4ERROR ((EXIT_FAILURE, 0, _("invalid multibyte character")));
+      obstack_grow (obs, bytes, count);
+    }
+  count = wcrtomb (bytes, L'\0', &state);
+  if (count == (size_t) -1)
+    M4ERROR ((EXIT_FAILURE, 0, _("invalid multibyte shift state")));
+  obstack_grow (obs, bytes, count - 1);
+}
