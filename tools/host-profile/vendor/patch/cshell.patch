+/* LC_MESSAGES defines affirmative responses; a byte comparison with 'y'
+   ignores both the C locale's uppercase form and other installed locales. */
+static bool
+is_affirmative (char const *answer)
+{
+  regex_t expression;
+  if (regcomp (&expression, nl_langinfo (YESEXPR), REG_EXTENDED | REG_NOSUB))
+    fatal ("Invalid locale affirmative expression");
+  bool result = regexec (&expression, answer, 0, nullptr, 0) == 0;
+  regfree (&expression);
+  return result;
+}
