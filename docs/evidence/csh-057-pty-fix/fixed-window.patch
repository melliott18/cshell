+static int exit_before_continue(struct csh_jobs *jobs, struct csh_job *job)
+{
+    siginfo_t event;
+    int rc;
+    do { rc = waitid(P_PID, (id_t)job->processes[0].pid, &event, WEXITED | WNOWAIT); }
+    while (rc < 0 && errno == EINTR);
+    if (rc < 0) return -1;
+    return continue_job(jobs, job);
+}
+
 static void promote_job(struct csh_jobs *jobs, struct csh_job *job)
 {
     struct csh_job **link = &jobs->head;
@@ -461,7 +471,7 @@
