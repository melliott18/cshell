mkdir -p build/tests/
# The helper observes descriptors after exec; sanitizer startup can reopen
# intentionally closed standard descriptors before main on macOS.
cc  -pthread -D_POSIX_C_SOURCE=200809L -Iinclude -Wall -Wextra -Wpedantic -Wshadow -std=c99 -O2 \
		 -o build/tests/execute_helper tests/execute_helper.c 
python3 tests/runtime_cases.py --helper build/tests/execute_helper --output build/tests/runtime.json
python3 tests/smoke.py ./cshell --suite build/tests/runtime.json \
		--timeout "5" --output-limit "65536"
