                 snprintf(script, sizeof(script), "exit %d & %s\n", i % 100 + 1,
                     i % 2 ? ":" : "saved=$!");
                 assert(run(&ctx, script).status == 0);
                 csh_state_get_info(ctx.state, &info);
                 ids[i] = info.background_pid;
