+static int progress_fd = -1;
+static void progress(const char *phase, int fallback, int round, int item, pid_t child)
+{
+    struct timespec now;
+    if (progress_fd < 0) return;
+    assert(clock_gettime(CLOCK_MONOTONIC, &now) == 0);
+    dprintf(progress_fd, "%ld.%09ld %s %d %d %d %ld\n", (long)now.tv_sec,
+        now.tv_nsec, phase, fallback, round, item, (long)child);
+}
