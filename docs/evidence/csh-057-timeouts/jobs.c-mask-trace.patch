@@ -14,6 +14,21 @@
 #include <sys/select.h>
 #include <sys/wait.h>
 #include <unistd.h>
+
+
+static void mask_probe(const char *where)
+{
+    sigset_t mask;
+    sigprocmask(SIG_SETMASK, NULL, &mask);
+    if (sigismember(&mask, SIGINT)) {
+        int fd = open("/tmp/csh057-mask-leak.log", O_WRONLY | O_CREAT | O_APPEND, 0600);
+        if (fd >= 0) {
+            dprintf(fd, "pid=%ld where=%s INT=%d CHLD=%d\n", (long)getpid(), where,
+                sigismember(&mask, SIGINT), sigismember(&mask, SIGCHLD));
+            close(fd);
+        }
+    }
+}
 
 static const int signals[] = {SIGCHLD, SIGINT, SIGQUIT, SIGTSTP, SIGTTIN, SIGTTOU, SIGHUP, SIGTERM};
 #define SIGNAL_COUNT (sizeof(signals) / sizeof(signals[0]))
@@ -376,6 +391,7 @@
 {
