ARG BASE_IMAGE=cshell-test:csh-117
FROM ${BASE_IMAGE}
COPY --chown=cshell:cshell Makefile Dockerfile /work/
COPY --chown=cshell:cshell src/ /work/src/
COPY --chown=cshell:cshell include/ /work/include/
COPY --chown=cshell:cshell tests/ /work/tests/
COPY --chown=cshell:cshell docs/ /work/docs/
COPY --chown=cshell:cshell tools/ /work/tools/
USER cshell
RUN make -j4 cshell host-profile
