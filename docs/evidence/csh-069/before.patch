 #include <sys/wait.h>
 #include <unistd.h>
 
+/* Keep the failure's PID and errno: the original H11 assertion lost both. */
+static void await_exit(pid_t pid)
+{
+    siginfo_t info;
+    int rc, saved_errno;
+    do { rc = waitid(P_PID, (id_t)pid, &info, WEXITED | WNOWAIT); }
+    while (rc == -1 && errno == EINTR);
+    saved_errno = errno;
+    if (rc != 0)
+        fprintf(stderr, "context waitid pid=%ld errno=%d (%s)\n",
+            (long)pid, saved_errno, strerror(saved_errno));
+    assert(rc == 0);
+    assert(info.si_pid == pid && info.si_code == CLD_EXITED);
+}
+
+#ifdef CSH_CONTEXT_SCHEDULE
+static int force_completed_child;
+static unsigned forced_polls;
+
+/* Only the schedule build's execute.o calls this wrapper. Block immediately
+ * before its real WNOHANG poll, without consuming or fabricating any status. */
+pid_t csh_context_waitpid(pid_t pid, int *status, int options)
+{
+    if (force_completed_child && (options & WNOHANG)) {
+        assert(pid > 0);
+        force_completed_child = 0;
+        await_exit(pid);
+        ++forced_polls;
+    }
+    return waitpid(pid, status, options);
+}
+#endif
+
 static struct csh_execution run(struct csh_execution_context *context, const char *text)
 {
     struct csh_input *input = NULL;
