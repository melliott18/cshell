# Send only the inputs needed to build and test a source snapshot.
# Host binaries, build output, Git metadata, and unrelated evidence stay outside it.
**
!.dockerignore
!Dockerfile
!Makefile
!include/
!include/**
!src/
!src/**
!tests/
!tests/**
**/__pycache__/
**/*.pyc

!tools/
!tools/**

# Complete host ownership checks read these normative/accounting inputs.
!docs/
!docs/host-system-inventory.md
!docs/host-permissions-identities.md
!docs/tickets/
!docs/tickets/*.md
!docs/evidence/
!docs/evidence/csh-012/
!docs/evidence/csh-012/closure-5b56328/
!docs/evidence/csh-012/closure-5b56328/utility-inventory.json
!docs/evidence/csh-012/closure-5b56328/utility-sources.json
!docs/evidence/csh-012/closure-5b56328/provider-inventory.py
!docs/evidence/csh-064/
!docs/evidence/csh-064/prerequisites.json
